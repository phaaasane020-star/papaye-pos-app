---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFBB00" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>Set up | Papaye Fast Food</title>
  </head>
  <body class="bg-paper font-sans text-ink">
    <main class="grid min-h-dvh place-items-center p-4">
      <div class="w-full max-w-md">
        <div class="mb-6 flex items-center gap-3">
          <div class="grid h-11 w-11 place-items-center rounded-2xl bg-gold text-lg font-extrabold">P</div>
          <div class="text-lg font-bold leading-tight">Papaye Fast Food</div>
        </div>

        <div id="closed" class="hidden rounded-2xl border border-mist/30 bg-white p-6">
          <h1 class="text-xl font-bold">Setup is already done</h1>
          <p class="mt-2 text-sm text-mist">A manager account already exists. Sign in to continue.</p>
          <a href="/login" class="btn-gold mt-5 block rounded-xl py-3 text-center font-bold">Go to sign in</a>
        </div>

        <div id="done" class="hidden rounded-2xl border border-mist/30 bg-white p-6">
          <h1 class="text-xl font-bold">Manager account created</h1>
          <p class="mt-2 text-sm text-mist">Taking you to sign in. You will be asked to link your authenticator app on first login.</p>
        </div>

        <form id="form" class="hidden rounded-2xl border border-mist/30 bg-white p-6">
          <h1 class="text-xl font-bold">Create the manager account</h1>
          <p class="mb-5 mt-1 text-sm text-mist">This works once. After it, only the manager can add staff.</p>

          <label for="code" class="text-sm font-semibold">Setup code</label>
          <input id="code" type="password" required autocomplete="off" class="mb-3 mt-1 w-full rounded-xl border border-mist/40 bg-white px-4 py-2.5 outline-none focus:border-gold" />

          <label for="name" class="text-sm font-semibold">Full name</label>
          <input id="name" required maxlength="60" autocomplete="name" class="mb-3 mt-1 w-full rounded-xl border border-mist/40 bg-white px-4 py-2.5 outline-none focus:border-gold" />

          <label for="username" class="text-sm font-semibold">Username</label>
          <input id="username" required maxlength="30" autocomplete="username" autocapitalize="none" class="mb-3 mt-1 w-full rounded-xl border border-mist/40 bg-white px-4 py-2.5 outline-none focus:border-gold" />

          <label for="phone" class="text-sm font-semibold">Phone (optional)</label>
          <input id="phone" type="tel" maxlength="20" autocomplete="tel" class="mb-3 mt-1 w-full rounded-xl border border-mist/40 bg-white px-4 py-2.5 outline-none focus:border-gold" />

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="pin" class="text-sm font-semibold">PIN (6+ digits)</label>
              <input id="pin" type="password" inputmode="numeric" pattern="[0-9]*" required maxlength="10" autocomplete="new-password" class="mt-1 w-full rounded-xl border border-mist/40 bg-white px-4 py-2.5 outline-none focus:border-gold" />
            </div>
            <div>
              <label for="pin2" class="text-sm font-semibold">Confirm PIN</label>
              <input id="pin2" type="password" inputmode="numeric" pattern="[0-9]*" required maxlength="10" autocomplete="new-password" class="mt-1 w-full rounded-xl border border-mist/40 bg-white px-4 py-2.5 outline-none focus:border-gold" />
            </div>
          </div>

          <p id="msg" class="mt-3 hidden text-sm font-semibold text-red-600"></p>

          <button id="go" type="submit" class="btn-gold mt-5 w-full rounded-xl py-3.5 font-bold text-ink">Create manager account</button>
        </form>
      </div>
    </main>

    <script>
      const $ = (id) => document.getElementById(id);
      const msg = $("msg");
      const show = (text) => {
        msg.textContent = text;
        msg.classList.remove("hidden");
      };

      async function start() {
        try {
          const res = await fetch("/api/setup");
          const data = await res.json();
          if (data.open && data.configured) $("form").classList.remove("hidden");
          else if (data.open && !data.configured) {
            $("closed").classList.remove("hidden");
            $("closed").querySelector("h1").textContent = "Setup is not enabled";
            $("closed").querySelector("p").textContent = "The server needs a SETUP_CODE before the manager account can be created.";
          } else $("closed").classList.remove("hidden");
        } catch {
          $("closed").classList.remove("hidden");
          $("closed").querySelector("h1").textContent = "Could not reach the server";
          $("closed").querySelector("p").textContent = "Check your internet connection and refresh.";
        }
      }

      $("form").addEventListener("submit", async (e) => {
        e.preventDefault();
        msg.classList.add("hidden");
        if ($("pin").value !== $("pin2").value) return show("The two PINs do not match.");

        const btn = $("go");
        btn.disabled = true;
        btn.textContent = "Creating...";
        try {
          const res = await fetch("/api/setup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              code: $("code").value,
              name: $("name").value,
              username: $("username").value,
              phone: $("phone").value,
              pin: $("pin").value,
            }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || "Could not create the account.");
          $("form").classList.add("hidden");
          $("done").classList.remove("hidden");
          setTimeout(() => (window.location.href = "/login"), 1500);
        } catch (err) {
          show(err.message);
          btn.disabled = false;
          btn.textContent = "Create manager account";
        }
      });

      start();
    </script>
  </body>
</html>