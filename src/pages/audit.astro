---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Activity" crumbs={["Activity"]}>
  <div>
    <h1 class="text-2xl font-bold">Activity log</h1>
    <p class="text-sm text-mist">The latest 200 security and management events</p>
  </div>

  <div id="list" class="mt-5 space-y-2"></div>
</AppLayout>

<script>
  import { api } from "../lib/client-api.js";

  const esc = (s) =>
    String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  const LABELS = {
    login: ["Signed in", "bg-green-100 text-green-800"],
    login_failed: ["Failed sign-in", "bg-red-100 text-red-700"],
    login_blocked: ["Blocked (locked)", "bg-red-100 text-red-700"],
    code_failed: ["Wrong authenticator code", "bg-red-100 text-red-700"],
    logout: ["Signed out", "bg-mist/20 text-ink"],
  };

  const list = document.getElementById("list");
  list.innerHTML = '<div class="h-16 animate-pulse rounded-2xl bg-white/70"></div>'.repeat(4);

  try {
    const { entries } = await api("/api/admin/audit");
    if (!entries.length) {
      list.innerHTML = '<p class="rounded-2xl bg-white/60 p-8 text-center text-sm text-mist">Nothing logged yet.</p>';
    } else {
      list.innerHTML = entries
        .map((e) => {
          const [label, cls] = LABELS[e.action] || [e.action.replace(/_/g, " "), "bg-gold/25 text-ink"];
          const detail = e.detail && Object.keys(e.detail).length ? JSON.stringify(e.detail) : "";
          return `
          <div class="rounded-2xl border border-mist/25 bg-white p-4 shadow-soft">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-lg px-2 py-1 text-xs font-bold ${cls}">${esc(label)}</span>
              <span class="text-xs text-mist">${esc(new Date(e.created_at).toLocaleString("en-GB"))}</span>
            </div>
            <div class="mt-2 text-sm"><span class="font-semibold">${esc(e.staff_name || "Unknown")}</span>
              <span class="text-mist"> · ${esc(e.ip || "")}</span></div>
            ${detail ? `<div class="mt-1 break-words font-mono text-xs text-mist">${esc(detail)}</div>` : ""}
          </div>`;
        })
        .join("");
    }
  } catch (e) {
    list.innerHTML = `<p class="text-sm font-semibold text-red-600">${esc(e.message)}</p>`;
  }
</script>