---
import { readSession } from "../lib/auth.js";

const path = Astro.url.pathname;
const user = Astro.locals.user ?? readSession(Astro.cookies);
const isAdmin = user?.role === "admin";

const icon = (d) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;

const all = [
  { label: "Dashboard", href: "/dashboard", svg: icon('<rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/>') },
  { label: "Sell", href: "/", svg: icon('<path d="M3 11h18l-2 9H5z"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>') },
  { label: "Bills", href: "/bills", svg: icon('<path d="M6 2h12v20l-3-2-3 2-3-2-3 2z"/><path d="M9 7h6M9 11h6"/>') },
  { label: "Products", href: "/products", adminOnly: true, svg: icon('<path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/>') },
  { label: "Staff", href: "/staff", adminOnly: true, svg: icon('<path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M21 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>') },
  { label: "Activity", href: "/audit", adminOnly: true, svg: icon('<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>') },
];
const main = all.filter((item) => !item.adminOnly || isAdmin);
---
<aside id="sidebar" class="flex w-60 shrink-0 flex-col overflow-y-auto bg-ink p-4 text-paper">
  <!-- Brand -->
  <div class="mb-6 flex items-center gap-3 px-2 py-3">
    <div class="float-y grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-gold text-lg font-extrabold text-ink shadow-lg">P</div>
    <div class="flex-1 text-[15px] font-bold leading-tight">Papaye Fast Food</div>
    <button id="closeMenu" type="button" aria-label="Close menu" class="press grid h-9 w-9 place-items-center rounded-lg text-paper/70 hover:bg-white/10">✕</button>
  </div>

  <!-- Nav -->
  <nav class="flex flex-col gap-1">
    {main.map((item, i) => {
      const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
      return (
        <a
          href={item.href}
          style={`--i:${i}`}
          class:list={[
            "flex items-center gap-3 rounded-xl px-3 py-3 text-sm font-medium transition duration-200",
            active
              ? "bg-gold text-ink shadow-lg shadow-black/20"
              : "text-paper/80 hover:translate-x-1 hover:bg-white/10 hover:text-paper",
          ]}
        >
          <Fragment set:html={item.svg} />
          {item.label}
        </a>
      );
    })}
  </nav>

  <!-- Cashier card -->
  <div class="mt-auto rounded-2xl bg-white/10 p-3">
    <div class="flex items-center gap-3">
      <div id="cashierInitial" class="grid h-10 w-10 place-items-center rounded-full bg-gold font-bold text-ink">C</div>
      <div class="min-w-0">
        <div id="cashierName" class="truncate text-sm font-semibold">Cashier</div>
        <div id="cashierRole" class="text-xs text-mist">On shift</div>
      </div>
    </div>
    <button id="logout" class="press mt-3 w-full rounded-lg bg-gold py-2 text-center text-xs font-semibold text-ink">Log out</button>
  </div>
</aside>

<script>
  import { getSession, logout } from "../lib/session.js";
  import { confirmAction } from "../lib/confirm.js";

  const s = getSession();
  if (s) {
    document.getElementById("cashierName").textContent = s.name;
    document.getElementById("cashierInitial").textContent = s.name[0].toUpperCase();
    document.getElementById("cashierRole").textContent = s.role === "admin" ? "Manager" : "On shift";
  }

  document.getElementById("logout").addEventListener("click", async () => {
    const ok = await confirmAction({
      title: "Log out?",
      message: "You will need your PIN and authenticator code to sign in again.",
      confirmText: "Yes, log out",
      danger: true,
    });
    if (ok) logout();
  });
</script>