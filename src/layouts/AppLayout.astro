---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import { readSession } from "../lib/auth.js";

const { title = "Papaye Fast Food", crumbs = [] } = Astro.props;

// Works with or without the middleware: use its result if present, otherwise read the cookie directly
const user = Astro.locals.user ?? readSession(Astro.cookies);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFBB00" />
    {!user && <meta http-equiv="refresh" content="0;url=/login" />}
    <script is:inline define:vars={{ user }}>
      window.__USER__ = user;
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title} | Papaye Fast Food</title>
  </head>
  <body class="bg-paper font-sans text-ink">
    {user ? (
      <div class="flex h-dvh overflow-hidden">
        <Sidebar />
        <div id="navScrim"></div>

        <div class="flex min-w-0 flex-1 flex-col">
          <!-- Top bar (yellow on every page) -->
          <header class="flex items-center gap-3 border-b border-black/10 bg-gold px-4 py-3 sm:px-6 sm:py-4">
            <button id="menuBtn" type="button" aria-label="Open menu" class="press grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-ink text-paper">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>

            <div class="hidden text-sm text-ink/70 sm:block">
              {crumbs.map((c, i) => (
                <span>
                  {i > 0 && <span class="mx-1">›</span>}
                  <span class={i === crumbs.length - 1 ? "font-bold text-ink" : ""}>{c}</span>
                </span>
              ))}
            </div>

            <input
              id="globalSearch"
              type="search"
              placeholder="Search..."
              class="min-w-0 flex-1 rounded-xl border border-black/10 bg-white px-4 py-2 text-sm outline-none transition focus:border-ink sm:ml-auto sm:w-64 sm:flex-none sm:focus:w-80"
            />
          </header>

          <main class="page-enter flex-1 overflow-y-auto p-4 sm:p-6">
            <slot />
          </main>
        </div>
      </div>
    ) : null}

    <script>
      const body = document.body;
      const open = () => body.classList.add("menu-open");
      const close = () => body.classList.remove("menu-open");

      document.getElementById("menuBtn")?.addEventListener("click", () =>
        body.classList.contains("menu-open") ? close() : open()
      );
      document.getElementById("navScrim")?.addEventListener("click", close);
      document.getElementById("closeMenu")?.addEventListener("click", close);
      document.getElementById("sidebar")?.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") close();
      });
    </script>
  </body>
</html>